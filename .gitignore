# ==============================================================================
# CONFIDENTIALITY & DATA PROTECTION GUARDRAILS
# Strictly ignore all confidential drone imagery, raw sensor data, geodata,
# flight records, and ground coordinates.
# ==============================================================================

# Data directories (raw flights, labels, and DSM)
data/raw/*
!data/raw/.gitkeep
data/labels/*
!data/labels/.gitkeep
data/dsm/*
!data/dsm/.gitkeep

# Confidential drone aerial imagery & rasters
*.jpg
*.jpeg
*.tif
*.tiff
*.bmp
*.azDownload*

# Confidential GNSS / PPK flight logs and telemetry
*.ulg
*.26o
*.26n
*.sbf
*.pos
*.ubx

# Confidential geospatial vector exports, geotags, and Labelbox annotations
*.ndjson
*.geojson
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.kml
*.kmz

# All JSON files containing survey flight geotags and metadata
*.json

# Generated pipeline runs, datasets, and intermediate outputs
work/
runs/
outputs/
export.ndjson

# Deep learning model weights & checkpoints
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.bin
*.engine

# Credentials, tokens, and local secrets
.env
.env.*
!*.env.example
*.key
*.token
credentials/
secrets/

# Python & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Test & lint caches
.pytest_cache/
.mypy_cache/
.cache/
*.log

# Virtual environments
.venv/
venv/
env/
ENV/

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
